@startuml
skinparam classAttributeIconSize 0
left to right direction

enum StatusTarefa {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDA
}

enum Prioridade {
  BAIXA
  MEDIA
  ALTA
}

class Usuario {
  - id: int
  - username: string
  - email: string
  - password: string
}

class Projeto {
  - id: int
  - usuario_id: int <<FK>>
  - nome: string
  - descricao: string
  - data_criacao: datetime
  - data_atualizacao: datetime

  + criar()
  + listar(): List<Projeto>
  + buscar(id: int)
  + atualizar(id: int)
  + excluir(id: int)
}

class Tarefa {
  - id: int
  - projeto_id: int <<FK>>
  - titulo: string
  - descricao: string
  - status: StatusTarefa
  - prioridade: Prioridade
  - prazo: date
  - data_criacao: datetime
  - data_atualizacao: datetime

  + criar()
  + listar(): List<Tarefa>
  + buscar(id: int)
  + atualizar(id: int)
  + excluir(id: int)
  + validar_prazo()
  + validar_titulo()
}

Usuario "1" -- "0..*" Projeto : possui >
Projeto "1" -- "0..*" Tarefa : contém >
Tarefa --> StatusTarefa
Tarefa --> Prioridade

@enduml